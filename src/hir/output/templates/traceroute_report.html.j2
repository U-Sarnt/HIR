<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Reporte Traceroute – {{ host }}</title>
  <style>
    body {
      background-color: #111;      /* Negro */
      color: #eee;                 /* Blanco suave */
      font-family: Arial, sans-serif;
      margin: 0; padding: 20px;
    }
    header {
      background-color: #ff6600;   /* Naranja */
      color: #111;
      padding: 10px;
      border-radius: 4px;
      text-align: center;
      font-size: 1.5em;
    }
    section {
      margin-top: 20px;
      background-color: #1a1a1a;   /* Gris oscuro */
      border-radius: 4px;
      padding: 15px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    th, td {
      border: 1px solid #333;
      padding: 8px;
      text-align: center;
    }
    th {
      background-color: #333;
      color: #ff6600;              /* Naranja */
    }
    tr:nth-child(even) {
      background-color: #222;
    }
    tr:nth-child(odd) {
      background-color: #1a1a1a;
    }
    footer {
      margin-top: 30px;
      text-align: right;
      color: #777;
      font-size: 0.9em;
    }
  </style>
</head>
<body>
  <header><h1>Traceroute a {{ host }}</h1></header>
  <section>
    <h2>Saltos</h2>
    <table>
      <thead>
        <tr><th>Hop</th><th>IP</th><th>RTT (ms)</th></tr>
      </thead>
      <tbody>
        {% for hop, ip, rtt in hops %}
        <tr>
          <td>{{ hop }}</td>
          <td>{{ ip }}</td>
          <td>{{ '%.2f'|format(rtt) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  <footer>Generado: {{ timestamp }}</footer>
</body>
</html>

